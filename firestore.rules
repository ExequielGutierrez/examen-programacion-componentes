rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /formularios/{formularioId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly([
          'nombre',
          'correo',
          'mensaje',
          'createdAt'
        ])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 1
        && request.resource.data.nombre.size() <= 80
        && request.resource.data.correo is string
        && request.resource.data.correo.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.mensaje is string
        && request.resource.data.mensaje.size() >= 10
        && request.resource.data.mensaje.size() <= 500
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
